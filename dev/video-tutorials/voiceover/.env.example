# Copy to .env and fill in. .env is gitignored (see .gitignore in this folder).
# A paid ElevenLabs plan is required for commercial usage rights on generated audio.

# Required for real generation (omit for --dry-run).
ELEVENLABS_API_KEY=

# The voice to narrate with. The production series uses a personal PVC voice —
# its id lives ONLY here in .env (public repo: never commit a voice id).
# List voices via:  GET https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=

# Model fallback. Every series script pins `model: eleven_v3` in its front matter
# (front matter beats this env var), so this only applies to scripts without a pin.
# The whole series shipped on eleven_v3 with stability 0.30 / style 0.0 — see
# README "Production settings".
#   eleven_v3               - production pick; honors [warm]/[pause] audio tags
#   eleven_multilingual_v2  - stable fallback; audio tags are stripped
ELEVENLABS_MODEL_ID=eleven_v3
