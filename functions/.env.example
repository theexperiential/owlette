# Cloud Function environment variables
# Copy to .env and fill in values

# Shared secret for internal API authentication (must match web/.env.local)
CORTEX_INTERNAL_SECRET=your_secret_here

# API base URL is auto-derived from Firebase project ID:
#   project contains "dev" → https://dev.owlette.app
#   otherwise             → https://owlette.app
# Uncomment to override:
# API_BASE_URL=https://dev.owlette.app

# R2 credentials for chunk GC (functions/src/chunkGc.ts). Same values as the
# railway/vercel web env — mint nothing new. Without these the nightly GC aborts
# before touching storage.
R2_S3_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=

# Which R2 bucket pair this deployment owns: dev|prod. Falls back to the firebase
# project id when unset, and refuses to run if that is ambiguous — a deletion job
# must never guess which environment's buckets it is pointed at.
ROOST_ENV=dev

# Chunk GC mode. Unset (or anything but the exact string "apply") = dry-run: the
# plan is logged, nothing is written. Flip to "apply" only after ~30 days of clean
# dry-run logs, which is one full tombstone TTL.
# CHUNK_GC_MODE=apply
